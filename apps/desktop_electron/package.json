{
  "name": "netconsole-desktop-electron",
  "private": true,
  "version": "1.4.4",
  "description": "NetConsole Electron desktop host",
  "author": "WXJ",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:codex": "node scripts/dev.mjs --codex",
    "smoke:dev": "node scripts/dev.mjs --smoke",
    "smoke:task-center": "node scripts/dev.mjs --smoke --task-center",
    "smoke:task-window": "pnpm run smoke:task-center",
    "smoke:workspace-tray": "node scripts/dev.mjs --smoke --workspace-tray",
    "profile:mesh-chart": "electron scripts/profile-mesh-chart.cjs",
    "profile:mesh-tooltip-repaint": "electron scripts/profile-mesh-tooltip-repaint.cjs",
    "start": "pnpm run build:main && electron .",
    "build": "pnpm run build:main && pnpm run build:web",
    "build:main": "pnpm run typecheck && node scripts/build.mjs",
    "build:web": "pnpm --dir ../web build",
    "package:prepare": "pnpm run build:main && node scripts/package.mjs",
    "package:dir": "pnpm run package:prepare && electron-builder --dir --win --x64",
    "package": "node scripts/build-installer.mjs",
    "smoke:package": "pnpm run package:dir && node scripts/package-smoke.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "build": {
    "appId": "com.loveok.netconsole",
    "productName": "NetConsole v1.4.4 by wxj",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "../../dist/electron"
    },
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/package-resources/backend",
        "to": "backend"
      },
      {
        "from": "../../resources/branding",
        "to": "branding",
        "filter": [
          "netconsole.ico",
          "netconsole.png"
        ]
      }
    ],
    "win": {
      "executableName": "NetConsole",
      "icon": "../../resources/branding/netconsole.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NetConsole-${version}-${arch}-setup.${ext}"
    },
    "nsis": {
      "unicode": true,
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer-data-root.nsh",
      "installerIcon": "../../resources/branding/netconsole.ico",
      "uninstallerIcon": "../../resources/branding/netconsole.ico",
      "installerHeaderIcon": "../../resources/branding/netconsole.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}

{
  "name": "netconsole-desktop-electron",
  "private": true,
  "version": "1.3.9",
  "description": "NetConsole Electron desktop host",
  "author": "WXJ",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:codex": "node scripts/dev.mjs --codex",
    "smoke:dev": "node scripts/dev.mjs --smoke",
    "smoke:task-window": "node scripts/dev.mjs --smoke --task-window",
    "start": "pnpm run build:main && electron .",
    "build": "pnpm run build:main && pnpm run build:web",
    "build:main": "pnpm run typecheck && node scripts/build.mjs",
    "build:web": "pnpm --dir ../web build",
    "package:prepare": "pnpm run build:main && node scripts/package.mjs",
    "package:dir": "pnpm run package:prepare && electron-builder --dir --win --x64",
    "package": "pnpm run package:prepare && electron-builder --win nsis --x64",
    "smoke:package": "pnpm run package:dir && node scripts/package-smoke.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "build": {
    "appId": "com.loveok.netconsole",
    "productName": "NetConsole",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "../../dist/electron"
    },
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/package-resources/backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NetConsole-${version}-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
